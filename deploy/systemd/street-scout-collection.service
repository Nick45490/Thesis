# Reference unit for self-hosting on a plain Linux VPS (no Docker).
# Copy to /etc/systemd/system/street-scout-collection.service, adjust paths for
# your actual deploy location, then:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now street-scout-collection

[Unit]
Description=Street Scout Collection Service
After=network.target postgresql.service

[Service]
Type=simple
User=streetscout
WorkingDirectory=/opt/street-scout/collection-service
EnvironmentFile=/opt/street-scout/collection-service/.env
ExecStart=/usr/bin/node src/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/street-scout/collection-service

[Install]
WantedBy=multi-user.target
