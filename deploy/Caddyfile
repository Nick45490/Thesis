# Reference Caddyfile for self-hosting on a plain Linux VPS (no Docker).
# Copy to /etc/caddy/Caddyfile, replace both domains with your real ones, then
# `sudo systemctl reload caddy`. Caddy gets Let's Encrypt TLS for both
# domains automatically — no certbot, no manual renewal.
#
# Remember: frontend/dist/ must be built with VITE_API_BASE_URL already set
# to the real https://api.yourdomain.com URL below (Vite bakes it in at
# build time, not read at runtime — see frontend/.env.example).

yourdomain.com {
	root * /opt/street-scout/frontend/dist
	file_server
	# SPA fallback — client-side routing (react-router-dom) needs every
	# unmatched path to still serve index.html, not a 404.
	try_files {path} /index.html
	encode gzip
}

api.yourdomain.com {
	reverse_proxy 127.0.0.1:8080
	encode gzip
}
