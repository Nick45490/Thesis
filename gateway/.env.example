PORT=8080
# Unlike every other service, the gateway is meant to be the one publicly
# reachable port — 0.0.0.0 is correct here even in production, as long as
# every other service (see their own .env.example HOST var) stays loopback-only.
HOST=0.0.0.0
NODE_ENV=development
JWT_SECRET=change-me

# Comma-separated list of origins allowed to call this API (e.g. add your LAN
# IP here too if testing from another device: http://localhost:5173,http://192.168.1.x:5173)
CORS_ORIGIN=http://localhost:5173

# Must match the same value in auth-service, collection-service,
# gamification-service, and ai-service — proves proxied requests actually came
# through this gateway. Those services now default to binding loopback-only
# (see their own HOST var) so they shouldn't be reachable directly at all in
# production, but this secret is the second, independent layer in case that
# ever isn't true (a misconfigured firewall, a HOST override left off).
INTERNAL_SERVICE_SECRET=change-me

# Upstream service URLs. These point at localhost since this project runs
# without Docker — for a real deployment, point them at wherever each service
# actually runs (still localhost if all on one box, or a private-network
# hostname if using a PaaS with internal service-to-service networking).
AUTH_SERVICE_URL=http://localhost:3001
CATALOGUE_SERVICE_URL=http://localhost:3002
COLLECTION_SERVICE_URL=http://localhost:3003
GAMIFICATION_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:8000

# Public API prefixes exposed by the gateway
AUTH_PREFIX=/auth
CATALOGUE_PREFIX=/catalogue
COLLECTION_PREFIX=/collection
GAMIFICATION_PREFIX=/gamification
AI_PREFIX=/recognize

# Rate limiting. RATE_LIMIT_MAX and AI_RATE_LIMIT_MAX each govern two
# separate limiters on protected routes (/collection, /gamification,
# /recognize): one keyed by client IP (the original), one keyed by the
# authenticated user's id (added later) — a request must pass both. The
# per-user one closes what the IP-only one leaves open: a single user
# rotating IPs would otherwise dodge the limit entirely, and several
# legitimate users behind one shared IP/NAT would otherwise share one bucket
# regardless of who's actually making the requests.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=50
# /recognize runs YOLO+CLIP inference per request, so it gets a much tighter limit.
AI_RATE_LIMIT_MAX=30
