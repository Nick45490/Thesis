PORT=8080
NODE_ENV=development
JWT_SECRET=change-me

# Comma-separated list of origins allowed to call this API (e.g. add your LAN
# IP here too if testing from another device: http://localhost:5173,http://192.168.1.x:5173)
CORS_ORIGIN=http://localhost:5173

# Must match the same value in auth-service, collection-service, and
# gamification-service — proves proxied requests actually came through this
# gateway (those services are also reachable directly on their own ports).
INTERNAL_SERVICE_SECRET=change-me

# Upstream service URLs
AUTH_SERVICE_URL=http://auth-service:3001
CATALOGUE_SERVICE_URL=http://catalogue-service:3002
COLLECTION_SERVICE_URL=http://collection-service:3003
GAMIFICATION_SERVICE_URL=http://gamification-service:3004
AI_SERVICE_URL=http://ai-service:8000

# Public API prefixes exposed by the gateway
AUTH_PREFIX=/auth
CATALOGUE_PREFIX=/catalogue
COLLECTION_PREFIX=/collection
GAMIFICATION_PREFIX=/gamification
AI_PREFIX=/recognize

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=50
# /recognize runs YOLO+CLIP inference per request, so it gets a much tighter limit.
AI_RATE_LIMIT_MAX=30
