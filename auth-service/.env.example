PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/thesis

JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Comma-separated list of origins allowed to call this API directly.
CORS_ORIGIN=http://localhost:5173

# Must match the gateway's and every other service's value exactly — guards the
# /internal/* endpoints (e.g. friendship checks) from being called by anyone
# other than another backend service.
INTERNAL_SERVICE_SECRET=change-me
