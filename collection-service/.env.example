PORT=3003
# Loopback-only by default — this service should only ever be reached through
# the gateway, never directly from the public internet.
HOST=127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/thesis

CATALOGUE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001

# Comma-separated list of origins allowed to call this API directly.
CORS_ORIGIN=http://localhost:5173

# Must match the same value in the gateway, auth-service, and
# gamification-service — without it every request is rejected, since this
# service is also reachable directly on its own port and trusts the
# gateway-injected x-user-id header only once this secret is verified.
INTERNAL_SERVICE_SECRET=change-me
