PORT=8000
# Loopback-only by default — this service should only ever be reached through
# the gateway, never directly from the public internet. Only the gateway
# itself should bind to a public interface. Passed to uvicorn's --host flag
# at startup (this file documents the value; uvicorn doesn't read it directly).
HOST=127.0.0.1

# Must match the exact same value in gateway/auth-service/collection-service/
# gamification-service's .env — the gateway sets this header on every proxied
# request (gateway/src/routes.js's applyIdentityHeaders); without a match,
# requests reaching this service directly (bypassing the gateway) are rejected.
INTERNAL_SERVICE_SECRET=change-me
