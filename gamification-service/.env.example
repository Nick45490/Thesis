PORT=3004
# Loopback-only by default — this service should only ever be reached through
# the gateway, never directly from the public internet.
HOST=127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/thesis

# Comma-separated list of origins allowed to call this API directly.
CORS_ORIGIN=http://localhost:5173

# Must match the same value in the gateway, auth-service, and
# collection-service — without it every request is rejected, since this
# service is also reachable directly on its own port and trusts the
# gateway-injected x-user-id header only once this secret is verified.
INTERNAL_SERVICE_SECRET=change-me
# Optional. During an INTERNAL_SERVICE_SECRET rotation, set this to the OLD
# value and keep INTERNAL_SERVICE_SECRET as the new one — requests bearing
# either are accepted, so the new secret can be rolled out to every service
# one at a time instead of needing a perfectly synchronized restart. The
# gateway itself only ever sends the current value. Remove entirely once
# every service (including the gateway) is confirmed on the new secret.
INTERNAL_SERVICE_SECRET_PREVIOUS=
