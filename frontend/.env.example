# The gateway's URL (not the frontend's own port) — the browser talks to this
# directly, so it must be reachable from wherever the frontend is loaded.
#
# IMPORTANT: Vite bakes this in at `npm run build` time, not read at runtime
# (see src/api/http.js) — for a production deploy, this must be set to the
# real public gateway URL (e.g. https://api.yourdomain.com) BEFORE running the
# build, or the shipped frontend silently points at localhost with no way to
# fix it after the fact short of rebuilding.
VITE_API_BASE_URL=http://localhost:8080
